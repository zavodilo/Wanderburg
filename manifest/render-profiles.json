            "elevationDeg": 18,
            "azimuthDeg": -90,
            "note": "follows the entity from behind, orbit allowed"
        },
        "firstPerson": {
            "projection": "perspective",
            "elevationDeg": 0,
            "azimuthDeg": -90,
            "note": "camera at the entity eyes, no external visual for it"
        },
