{
    "manifestVersion": 1,
    "kit": "ArcEngine",
    "canon": "manifest/render-profiles.json",
    "generated": "js/presentation/RenderProfiles.js (node tools/render-profiles.mjs)",
    "note": "Machine-readable canon of the visual profiles. A profile decides HOW the game looks, never HOW it plays: gameplay, entity ids, world logic, rules, progression and the save schema are identical in every profile. Adapters (behaviour) live in js/profiles/<id>/profile.js and read their data from here.",
    "coordinateSystem": {
        "x": "horizontal",
        "y": "vertical / height (up)",
        "z": "depth / forward",
        "handedness": "right-handed",
        "units": "px (1 px = 1 cm of a model file)",
        "rule": "A 2D game is the y = 0 case of the same space, not a separate space. Logical coordinates never change when the render profile changes.",
        "engine": "the PlayCanvas world is the map mirror on X: pc(-x, y, z); the kit map record is { x, y: z, h: y } (js/core/Coords.js)"
    },
    "order": [
        "2d",
        "2.5d",
        "isometric3d",
        "lowpoly3d",
        "full3d"
    ],
    "dimension": {
        "2d": 2,
        "2.5d": 2.5,
        "isometric3d": 3,
        "lowpoly3d": 3,
        "full3d": 3
    },
    "representationTypes": {
        "sprite": {
            "engine": "Sprite2D",
            "geometry": "textured quad",
            "dimensions": [
                2,
                2.5
            ],
            "note": "flat quad, faces the camera plane of the profile"
        },
        "billboard": {
            "engine": "Sprite2D",
            "geometry": "textured quad",
            "dimensions": [
                2.5,
                3
            ],
            "note": "sprite that always faces the camera in a 3D world"
        },
        "model": {
            "engine": "Model3D/Gltf3D",
            "geometry": "mesh (fbx/glb)",
            "dimensions": [
                2.5,
                3
            ],
            "note": "static or skinned model with clips"
        },
        "primitive": {
            "engine": "Procedural3D",
            "geometry": "generated mesh",
            "dimensions": [
                2.5,
                3
            ],
            "note": "box/crate/tree/rock/pole/capsule stand-in, no file needed"
        },
        "tile": {
            "engine": "Sprite2D/Procedural3D",
            "geometry": "quad or low box",
            "dimensions": [
                2,
                2.5,
                3
            ],
            "note": "one logical WorldMap tile"
        },
        "terrain": {
            "engine": "Terrain3D",
            "geometry": "heightfield mesh",
            "dimensions": [
                3
            ],
            "note": "the ground of a 3D profile"
        },
        "particle": {
            "engine": "Sprite2D/pc particles",
            "geometry": "points/quads",
            "dimensions": [
                2,
                2.5,
                3
            ],
            "note": "effect, never gameplay"
        },
        "none": {
            "engine": "-",
            "geometry": "-",
            "dimensions": [
                2,
                2.5,
                3
            ],
            "note": "logical entity without a visual (trigger, zone, spawn point)"
        }
    },
    "entityTypes": [
        "character",
        "creature",
        "prop",
        "structure",
        "vehicle",
        "projectile",
        "item",
        "terrain",
        "trigger",
        "zone",
        "effect"
    ],
    "animationStates": [
